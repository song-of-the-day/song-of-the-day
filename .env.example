# Song of the Day: environment variables.
#
#   cp .env.example .env     # .env is git-ignored; never commit real values
#
# docker-compose.yml loads .env into the `api` and `migrate` containers (which run with
# APP_ENV=production) and also reads POSTGRES_PASSWORD from it. Compose itself sets
# DATABASE_URL, TRUSTED_PROXY_COUNT=1 and RATELIMIT_STORAGE_URI for those containers, so their
# lines below only matter for the local `make api` / `make test` workflow. The Makefile does
# NOT load this file: export overrides in your shell (e.g. DATABASE_URL) for local runs.
#
# Secrets are left empty on purpose. Variables that are commented out use the default shown.

# --- Application -----------------------------------------------------------------
# development | testing | production. The images set production; `make api` sets development
# and `make test` sets testing, so leave this commented out.
# APP_ENV=development

# Flask signing key (sessions, CSRF, password-reset tokens). Required in production: at least
# 32 characters and not a placeholder. Development and testing have a built-in fallback.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Public origin of the app, used in password-reset links. Required in production and must be
# https:// (http://localhost[:port] is accepted for local production-mode runs).
# Default (development only): http://localhost:5173
APP_BASE_URL=https://sotd.example.com

# Secure (HTTPS-only) cookies; also drives REMEMBER_COOKIE_SECURE. Defaults to true in
# production, where cookies are then named __Host-sotd_session / __Host-sotd_remember. Only the
# plain-http e2e stack turns it off.
# SESSION_COOKIE_SECURE=true

# Number of reverse proxies in front of gunicorn whose X-Forwarded-* headers are trusted
# (ProxyFix): 1 for the bundled nginx, 2 when a TLS load balancer sits in front of nginx.
# Required in production; compose sets it to 1 (override with TRUSTED_PROXY_COUNT in your shell
# or here). Default (development only): 0.
# TRUSTED_PROXY_COUNT=1

# gunicorn worker processes (sync workers; roughly 2 x CPU cores is a good start).
# WEB_CONCURRENCY=2

# --- Database --------------------------------------------------------------------
# Password of the `sotd` role in the compose `db` service. Required by docker compose.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# (For a local-only development database, `sotd` matches the DATABASE_URL default below.)
POSTGRES_PASSWORD=

# SQLAlchemy URL for local runs (compose builds its own from POSTGRES_PASSWORD).
# postgres:// and postgresql:// are normalized to postgresql+psycopg://.
# DATABASE_URL=postgresql+psycopg://sotd:sotd@localhost:5432/sotd

# Server used by pytest: every run creates and drops "<dbname>_<worker>_<8 hex>" there, so
# the role needs CREATEDB.
# TEST_DATABASE_URL=postgresql+psycopg://sotd:sotd@localhost:5432/sotd_test

# --- Rate limiting ---------------------------------------------------------------
# true by default (false in tests). Production refuses memory:// storage unless this is false.
# RATELIMIT_ENABLED=true

# Counter storage. Compose uses redis://redis:6379/0. Default (development only): memory://
# RATELIMIT_STORAGE_URI=redis://redis:6379/0

# --- Mail (password-reset emails) ------------------------------------------------
# smtp | console | memory. Required in production, where it must be smtp. Defaults: console in
# development (the message is logged), memory in tests.
MAIL_BACKEND=smtp

# Allows MAIL_BACKEND=console in production mode. Only the throwaway e2e stack sets this.
# ALLOW_CONSOLE_MAIL=false

# SMTP settings. Production needs MAIL_SERVER, MAIL_FROM and one of MAIL_USE_TLS (STARTTLS,
# usually port 587) or MAIL_USE_SSL (implicit TLS, usually port 465); plaintext SMTP is refused.
MAIL_SERVER=
# MAIL_PORT defaults to 465 with MAIL_USE_SSL, otherwise 587.
# MAIL_PORT=587
MAIL_USERNAME=
# Your SMTP provider's password or API key.
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
# Sender address, e.g. "Song of the Day <no-reply@sotd.example.com>".
MAIL_FROM=
# Seconds before an SMTP connection or command times out.
# MAIL_TIMEOUT=10

# --- YouTube auto-match (optional) ------------------------------------------------
# YouTube Data API v3 key for the auto-match endpoint. Without it the
# feature is disabled (reason "disabled") and users paste video links themselves. Restrict
# the key to the YouTube Data API in Google Cloud.
YOUTUBE_API_KEY=

# --- Logging and paths ------------------------------------------------------------
# LOG_LEVEL=INFO
# json (one object per line; the production default) or text (the default elsewhere).
# LOG_FORMAT=json

# Customization options shared by the API and the web app. The backend image sets
# /app/shared/theme-options.json; the default <repo>/shared/theme-options.json only works in a
# source checkout.
# THEME_OPTIONS_PATH=/app/shared/theme-options.json

# Username rules and reserved names shared by the API and the web app. The backend image sets
# /app/shared/usernames.json; the default <repo>/shared/usernames.json only works in a source
# checkout.
# USERNAMES_PATH=/app/shared/usernames.json

# --- Compose host ports (optional) ------------------------------------------------
# Host binding of the web (nginx) container, e.g. 127.0.0.1:8080 behind a TLS proxy.
# WEB_PORT=8080
# Loopback host port of the db container (for `make api`, backups and maintenance).
# POSTGRES_PORT=5432
